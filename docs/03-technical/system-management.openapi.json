{
  "openapi": "3.1.0",
  "info": { "title": "系统管理 API", "version": "0.1.0", "description": "FR-SYS-03/04/05 的只读日志与组织基础配置切片。所有系统数据范围均要求 all，避免范围不明时扩大暴露。" },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/system/settings": {
      "get": { "summary": "读取组织显示名与时区", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Settings" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } },
      "patch": { "summary": "更新组织显示名与 IANA 时区", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingsUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Settings" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }
    },
    "/system/login-records": {
      "get": { "summary": "分页查询登录成功/失败记录", "security": [{ "session": [] }], "parameters": [{ "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "name": "email", "in": "query", "schema": { "type": "string", "maxLength": 120 } }, { "name": "result", "in": "query", "schema": { "enum": ["success", "failure"] } }, { "name": "ip", "in": "query", "schema": { "type": "string", "maxLength": 128 } }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }], "responses": { "200": { "$ref": "#/components/responses/LoginRecordPage" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }
    },
    "/system/operation-logs": {
      "get": { "summary": "分页查询只追加操作日志", "security": [{ "session": [] }], "parameters": [{ "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "name": "actorUserId", "in": "query", "schema": { "type": "string" } }, { "name": "action", "in": "query", "schema": { "type": "string" } }, { "name": "resourceType", "in": "query", "schema": { "type": "string" } }, { "name": "result", "in": "query", "schema": { "enum": ["success", "failure"] } }, { "name": "requestId", "in": "query", "schema": { "type": "string" } }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }], "responses": { "200": { "$ref": "#/components/responses/AuditLogPage" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }
    }
  },
  "components": {
    "securitySchemes": { "session": { "type": "apiKey", "in": "cookie", "name": "collab_session" }, "csrf": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token" } },
    "parameters": { "Origin": { "name": "Origin", "in": "header", "required": true, "schema": { "type": "string" } }, "From": { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } }, "To": { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } }, "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } }, "PageSize": { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } },
    "schemas": {
      "SettingsUpdate": { "type": "object", "additionalProperties": false, "required": ["version", "displayName", "timezone"], "properties": { "version": { "type": "integer", "minimum": 1 }, "displayName": { "type": "string", "minLength": 2, "maxLength": 80 }, "timezone": { "type": "string", "description": "有效 IANA timezone" } } },
      "Settings": { "type": "object", "required": ["id", "version", "displayName", "timezone", "workflowAllowSelfApproval"], "properties": { "id": { "type": "string" }, "version": { "type": "integer" }, "displayName": { "type": "string" }, "timezone": { "type": "string" }, "workflowAllowSelfApproval": { "const": false } } },
      "LoginRecord": { "type": "object", "required": ["id", "userId", "email", "success", "reason", "ip", "userAgent", "createdAt"], "properties": { "id": { "type": "string" }, "userId": { "type": ["string", "null"] }, "email": { "type": "string" }, "success": { "type": "boolean" }, "reason": { "type": ["string", "null"] }, "ip": { "type": ["string", "null"] }, "userAgent": { "type": ["string", "null"] }, "createdAt": { "type": "string", "format": "date-time" } } },
      "AuditLog": { "type": "object", "required": ["id", "actorUserId", "actorName", "action", "resourceType", "result", "metadata", "createdAt"], "properties": { "id": { "type": "string" }, "actorUserId": { "type": ["string", "null"] }, "actorName": { "type": ["string", "null"] }, "action": { "type": "string" }, "resourceType": { "type": "string" }, "result": { "enum": ["success", "failure"] }, "metadata": { "type": "object" }, "createdAt": { "type": "string", "format": "date-time" } } }
    },
    "responses": { "Settings": { "description": "组织基础配置", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Settings" } } } } } }, "LoginRecordPage": { "description": "登录记录分页", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/LoginRecord" } }, "meta": { "type": "object" } } } } } }, "AuditLogPage": { "description": "操作日志分页", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/AuditLog" } }, "meta": { "type": "object" } } } } } }, "Problem": { "description": "problem+json 错误" } }
  }
}
