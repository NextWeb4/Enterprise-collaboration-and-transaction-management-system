{
  "openapi": "3.1.0",
  "info": { "title": "企业协同平台文档中心 API", "version": "0.1.0", "description": "文档、版本、版本恢复、分类、标签、ACL 与批量操作；文件只通过文档资源下载。" },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "Session": [] }],
  "paths": {
    "/documents/batch": { "post": { "summary": "逐项执行批量文档操作", "description": "每个文档独立重验 document:acl:manage、manage 级 ACL 和 version，并在各自 LMDB 事务内同时写入业务变更与审计。最多 100 项；单项失败不回滚其他项。add_tags 为追加语义，不移除已有标签；分类为空表示移动至根目录。", "x-permission": "document:acl:manage", "requestBody": { "$ref": "#/components/requestBodies/DocumentBatch" }, "responses": { "200": { "$ref": "#/components/responses/DocumentBatch" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "description": "请求结构无效、包含重复文档或超过 100 项" } } } },
    "/documents/{id}/versions/{childId}/restore": { "post": { "summary": "将历史版本复制为新版本（不覆盖历史）", "description": "仅 active 文档且当前主体具备 edit 级文档 ACL；请求体 version 为文档乐观锁版本，note 可记录恢复来源。", "x-permission": "document:version:create", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/ChildId" }], "requestBody": { "$ref": "#/components/requestBodies/Restore" }, "responses": { "201": { "$ref": "#/components/responses/Document" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/documents/{id}/versions": { "post": { "summary": "上传新版本", "x-permission": "document:version:create", "requestBody": { "$ref": "#/components/requestBodies/VersionUpload" }, "responses": { "201": { "$ref": "#/components/responses/Document" } } } },
    "/documents/{id}/download": { "get": { "summary": "下载当前版本", "x-permission": "document:read", "responses": { "200": { "description": "受鉴权的二进制流；private, no-store" } } } },
    "/documents/{id}/preview": { "get": { "summary": "预览当前 PDF、PNG 或 JPEG 版本", "description": "先后两次重新校验会话和文档 ACL；只允许 application/pdf、image/png、image/jpeg。响应使用 inline、private, no-store、nosniff 和受限 CSP，并追加 document.previewed 审计。", "x-permission": "document:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "受鉴权的内联二进制流；仅 PDF、PNG、JPEG" }, "404": { "$ref": "#/components/responses/NotFound" }, "415": { "description": "文件类型不支持在线预览" } } } },
    "/documents/{id}/versions/{childId}/download": { "get": { "summary": "下载指定版本", "x-permission": "document:read", "responses": { "200": { "description": "受鉴权的二进制流" } } } },
    "/documents/{id}/versions/{childId}/preview": { "get": { "summary": "预览指定 PDF、PNG 或 JPEG 版本", "description": "与当前版本预览使用相同的 ACL、文件完整性和审计约束。", "x-permission": "document:read", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/ChildId" }], "responses": { "200": { "description": "受鉴权的内联二进制流；仅 PDF、PNG、JPEG" }, "404": { "$ref": "#/components/responses/NotFound" }, "415": { "description": "文件类型不支持在线预览" } } } }
  },
  "components": {
    "securitySchemes": { "Session": { "type": "apiKey", "in": "cookie", "name": "session" } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, "ChildId": { "name": "childId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "requestBodies": {
      "VersionUpload": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file", "metadata"], "properties": { "file": { "type": "string", "format": "binary" }, "metadata": { "type": "string", "description": "JSON: version, note" } } } } } },
      "Restore": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "minimum": 1 }, "note": { "type": "string", "maxLength": 200 } } } } } },
      "DocumentBatch": { "required": true, "content": { "application/json": { "schema": { "oneOf": [{ "type": "object", "required": ["operation", "categoryId", "items"], "properties": { "operation": { "const": "move_category" }, "categoryId": { "type": ["string", "null"], "format": "uuid" }, "items": { "$ref": "#/components/schemas/DocumentBatchItems" } } }, { "type": "object", "required": ["operation", "tagIds", "items"], "properties": { "operation": { "const": "add_tags" }, "tagIds": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }, "items": { "$ref": "#/components/schemas/DocumentBatchItems" } } }, { "type": "object", "required": ["operation", "items"], "properties": { "operation": { "const": "archive" }, "items": { "$ref": "#/components/schemas/DocumentBatchItems" } } }] } } } }
    },
    "schemas": { "DocumentBatchItems": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string", "format": "uuid" }, "version": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } }, "DocumentBatchResult": { "type": "object", "required": ["results", "succeeded", "failed"], "properties": { "results": { "type": "array", "items": { "oneOf": [{ "type": "object", "required": ["id", "success", "version"], "properties": { "id": { "type": "string", "format": "uuid" }, "success": { "const": true }, "version": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }, { "type": "object", "required": ["id", "success", "code", "message"], "properties": { "id": { "type": "string", "format": "uuid" }, "success": { "const": false }, "code": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": false }] } }, "succeeded": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } },
    "responses": { "Document": { "description": "文档" }, "DocumentBatch": { "description": "包含逐项成功/失败结果及计数", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentBatchResult" } } } }, "Forbidden": { "description": "权限不足" }, "NotFound": { "description": "资源不存在或无权访问" }, "Conflict": { "description": "版本/状态冲突" } }
  }
}
