# 本地开发环境变量模板（复制为 .env；.env 不入库）
# 生产部署用绝对路径，例如 DATA_DIR=D:\EnterprisePlatform\data
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# 注意：数据目录必须在本地 NTFS 盘（决策 D-028）；禁止网络盘/OneDrive/同步目录
# pnpm dev 默认使用 %LOCALAPPDATA%\collab-office-bootstrap\data；此文件不会自动加载
# DATA_DIR=C:\collab-office-bootstrap\data
WEB_ORIGIN=http://127.0.0.1:5173
SESSION_COOKIE_NAME=collab_session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
MAX_UPLOAD_MB=25
LOG_LEVEL=debug
TRUST_PROXY=false
