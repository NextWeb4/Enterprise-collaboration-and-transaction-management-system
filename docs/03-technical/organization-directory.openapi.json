{
  "openapi": "3.1.0",
  "info": { "title": "组织目录、员工与岗位 API", "version": "0.1.0", "description": "单组织目录契约；服务端在每次调用时重验会话、账号、角色和权限。" },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/organization/directory": { "get": { "summary": "查询脱敏通讯录", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Directory" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/organization/active-users": { "get": { "summary": "查询全部在职账号的最小选择器", "description": "供审批、交接和员工档案选择。返回项不要求已建立员工档案。", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/ActiveUsers" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/organization/departments/tree": { "get": { "summary": "查询当前范围内的部门树与人员计数", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/DepartmentTree" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/organization/employees": {
      "get": { "summary": "查询员工档案", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Employees" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } },
      "post": { "summary": "创建员工档案", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Employee" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }
    },
    "/organization/employees/{id}": { "get": { "summary": "读取单个员工档案", "security": [{ "session": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Employee" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } } }, "patch": { "summary": "更新员工档案", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Employee" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/organization/positions": { "get": { "summary": "查询岗位", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Positions" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } }, "post": { "summary": "创建岗位", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PositionInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Position" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/organization/positions/{id}": { "patch": { "summary": "更新岗位或设置启停状态", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PositionUpdate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Position" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }, "delete": { "summary": "软删除未被员工引用的岗位", "security": [{ "session": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Origin" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "minimum": 1 } } } } } }, "responses": { "200": { "description": "删除成功" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } } } }
  },
  "components": {
    "securitySchemes": { "session": { "type": "apiKey", "in": "cookie", "name": "collab_session" }, "csrf": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token" } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 64 } }, "Origin": { "name": "Origin", "in": "header", "required": true, "schema": { "type": "string" } } },
    "schemas": {
      "EmployeeInput": { "type": "object", "additionalProperties": false, "required": ["userId", "employeeNo", "phone", "departmentId", "positionId", "managerId", "hireDate", "avatarFileId"], "properties": { "userId": { "type": "string" }, "employeeNo": { "type": ["string", "null"] }, "phone": { "type": ["string", "null"], "description": "仅本人及管理员在响应中可见，且已脱敏" }, "departmentId": { "type": ["string", "null"] }, "positionId": { "type": ["string", "null"] }, "managerId": { "type": ["string", "null"], "description": "持久化到 UserDocument.managerId，非 EmployeeDocument 的重复字段" }, "hireDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "avatarFileId": { "type": "null", "description": "头像上传、授权和 refCount 绑定尚未实现；非 null 一律拒绝" } } },
      "EmployeeUpdate": { "allOf": [{ "$ref": "#/components/schemas/EmployeeInput" }, { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "minimum": 1 } } }] },
      "PositionInput": { "type": "object", "additionalProperties": false, "required": ["name", "code", "description", "sortOrder", "status"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "code": { "type": "string", "minLength": 1, "maxLength": 64 }, "description": { "type": "string", "maxLength": 300 }, "sortOrder": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "status": { "enum": ["active", "inactive"] } } },
      "PositionUpdate": { "allOf": [{ "$ref": "#/components/schemas/PositionInput" }, { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "minimum": 1 } } }] },
      "ActiveUser": { "type": "object", "required": ["userId", "name"], "properties": { "userId": { "type": "string" }, "name": { "type": "string" } } },
      "Position": { "type": "object", "required": ["id", "version", "name", "code", "description", "sortOrder", "status"], "properties": { "id": { "type": "string" }, "version": { "type": "integer" }, "name": { "type": "string" }, "code": { "type": "string" }, "description": { "type": "string" }, "sortOrder": { "type": "integer" }, "status": { "enum": ["active", "inactive"] } } }
    },
    "responses": { "Directory": { "description": "脱敏通讯录" }, "ActiveUsers": { "description": "在职账号选择器", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ActiveUser" } } } } } } }, "DepartmentTree": { "description": "部门树" }, "Employees": { "description": "员工档案集合" }, "Employee": { "description": "员工档案" }, "Positions": { "description": "岗位集合" }, "Position": { "description": "岗位" }, "Problem": { "description": "problem+json 错误" } }
  }
}
